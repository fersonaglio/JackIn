# ===== JackIn — configuração (preencher apenas o que for usar; tudo vazio por padrão) =====

# URL base da API do servidor (web)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Backdrops/posters via TMDB — OPCIONAL. Sem a chave, o buscador cai para artwork do iTunes.
# Grátis em https://www.themoviedb.org/settings/api
# Também alimenta a interpretação de busca (título PT→EN, ano e tipo).
TMDB_API_KEY=

# Legendas PT-BR via OpenSubtitles — OPCIONAL (sem ela, só sidecar/embutidas)
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Prowlarr (agregador de indexers) + FlareSolverr (bypass Cloudflare) — OPCIONAL
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=
FLARESOLVERR_URL=

# Fontes — desligar/ligar scrapers
ENABLE_1337X=1
ENABLE_NYAA=1
ENABLE_PROWLARR=1

# Binários (vazio = auto-detect via PATH)
FFMPEG_BIN=
FFPROBE_BIN=
ARIA2_BIN=

# Trackers P2P customizados (vazio = lista interna de fallback)
P2P_TRACKERS=

# 1 = desativa verificação SSL dos scrapers (usar com cautela)
P2P_INSECURE_SSL=0

# 1 = transcode mais rápido via VideoToolbox (macOS; qualidade menor)
JACKIN_FAST_TRANSCODE=

# IP da LAN para teste e2e de Cast — OPCIONAL (default no spec: 192.168.1.5)
E2E_LAN_IP=
